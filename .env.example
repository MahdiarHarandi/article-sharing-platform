# Copy this file to .env and replace every placeholder before running Docker Compose.
APP_PORT=8080

MYSQL_DATABASE=ie_articles
MYSQL_USER=ie_user
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Generate at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=article-sharing-api
JWT_LIFETIME_MINUTES=120
PASSWORD_HASH_ITERATIONS=210000
SEED_DEMO_DATA=false

# Optional seed data; set both values only in a disposable demo environment.
# SEED_DEMO_DATA=true
# DEMO_PASSWORD=choose-a-unique-strong-demo-password
