# Used only when running the backend outside Docker.
DB_URL=jdbc:mysql://localhost:3306/ie_articles?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=ie_user
DB_PASSWORD=replace-with-your-local-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=article-sharing-api
JWT_LIFETIME_MINUTES=120
PASSWORD_HASH_ITERATIONS=210000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=false
